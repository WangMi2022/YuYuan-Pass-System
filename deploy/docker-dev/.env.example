PROJECT_NAME=mit-assets-admin-dev
SERVER_IMAGE=mit-assets-admin-server:dev
WEB_IMAGE=mit-assets-admin-web:dev
SERVER_CONTAINER=maa-server-dev
WEB_CONTAINER=maa-web-dev
SERVER_PORT=8888
SERVER_BIND=127.0.0.1
WEB_PORT=8080

# 必须在已初始化数据库的环境中注入至少 32 字节的随机 JWT 密钥。
MAA_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
MAA_INSTALL_MODE=false
MAA_INSTALL_TOKEN=replace-with-a-one-time-local-install-token
MAA_ENABLE_PUBLIC_UPLOADS=false
MAA_ENABLE_SWAGGER=false

MAA_DB_TYPE=pgsql
MAA_PG_HOST=127.0.0.1
MAA_PG_PORT=5432
MAA_PG_USER=postgres
MAA_PG_PASSWORD=change-me
MAA_PG_DB=maa
MAA_PG_TEMPLATE=template0
MAA_ADMIN_PASSWORD=change-me-now

MAA_USE_REDIS=true
MAA_REDIS_ADDR=127.0.0.1:6379
MAA_REDIS_PASSWORD=change-me
MAA_REDIS_DB=0

# RustFS 控制台通常为 :9001，应用必须连接 S3 API（通常为 :9000）
MAA_RUSTFS_ENDPOINT=127.0.0.1:9000
MAA_RUSTFS_CONSOLE=http://127.0.0.1:9001
MAA_RUSTFS_ACCESS_KEY=change-me
MAA_RUSTFS_SECRET_KEY=change-me
MAA_RUSTFS_BUCKET=maa-assets
MAA_RUSTFS_BASE_PATH=assets
MAA_RUSTFS_USE_SSL=false
