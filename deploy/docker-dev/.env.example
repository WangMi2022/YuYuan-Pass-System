PROJECT_NAME=mit-assets-admin-dev
SERVER_IMAGE=mit-assets-admin-server:dev
WEB_IMAGE=mit-assets-admin-web:dev
SERVER_CONTAINER=gva-server-dev
WEB_CONTAINER=gva-web-dev
SERVER_PORT=8888
SERVER_BIND=127.0.0.1
WEB_PORT=8080

# 必须在已初始化数据库的环境中注入至少 32 字节的随机 JWT 密钥。
GVA_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
GVA_INSTALL_MODE=false
GVA_INSTALL_TOKEN=replace-with-a-one-time-local-install-token
GVA_ENABLE_PUBLIC_UPLOADS=false
GVA_ENABLE_SWAGGER=false

GVA_DB_TYPE=pgsql
GVA_PG_HOST=127.0.0.1
GVA_PG_PORT=5432
GVA_PG_USER=postgres
GVA_PG_PASSWORD=change-me
GVA_PG_DB=gva
GVA_PG_TEMPLATE=template0
GVA_ADMIN_PASSWORD=change-me-now

GVA_USE_REDIS=true
GVA_REDIS_ADDR=127.0.0.1:6379
GVA_REDIS_PASSWORD=change-me
GVA_REDIS_DB=0

# RustFS 控制台通常为 :9001，应用必须连接 S3 API（通常为 :9000）
GVA_RUSTFS_ENDPOINT=127.0.0.1:9000
GVA_RUSTFS_CONSOLE=http://127.0.0.1:9001
GVA_RUSTFS_ACCESS_KEY=change-me
GVA_RUSTFS_SECRET_KEY=change-me
GVA_RUSTFS_BUCKET=gva-assets
GVA_RUSTFS_BASE_PATH=assets
GVA_RUSTFS_USE_SSL=false
